<!-- pages/history/history.wxml - 变声历史记录 -->
<view class="page container">
  <view class="page-header">
    <text class="icon-title">📋</text>
    <text class="title">变声历史</text>
    <text class="subtitle">查看所有变声记录</text>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar" wx:if="{{history.length > 0}}">
    <text class="count-text">共 {{history.length}} 条记录</text>
    <button class="clear-btn" bindtap="clearAll" size="mini">清空全部</button>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:if="{{history.length > 0}}">
    <view class="card history-item" wx:for="{{history}}" wx:key="id"
          bindtap="openPlayer" data-taskid="{{item.taskId}}" data-name="{{item.songName}}">
      <view class="item-left">
        <text class="item-icon">🎶</text>
        <view class="item-info">
          <text class="item-name">{{item.songName || '未命名'}}</text>
          <text class="item-time">{{item.createTimeText}}</text>
        </view>
      </view>
      <view class="item-right">
        <text class="item-pitch" wx:if="{{item.pitchShift}}">
          {{item.pitchShift > 0 ? '+' : ''}}{{item.pitchShift}}半音
        </text>
        <text class="item-arrow">▶</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">🎵</text>
    <text class="empty-title">暂无记录</text>
    <text class="empty-desc">去"变声"页面试试吧</text>
  </view>
</view>
