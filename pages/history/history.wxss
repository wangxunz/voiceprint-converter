.page { padding-bottom: 60px; }
.page-header { text-align: center; padding: 30px 0 20px; }
.icon-title { font-size: 48px; display: block; margin-bottom: 12px; }
.title { font-size: 24px; font-weight: 700; color: #2d3436; display: block; }
.subtitle { font-size: 14px; color: #999; margin-top: 6px; display: block; }

.action-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 4px 12px;
}
.count-text { font-size: 14px; color: #636e72; }
.clear-btn { font-size: 12px; color: #d63031; background: none; }

.history-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px;
}
.history-item:active { background: #f8f7ff; }
.item-left { display: flex; align-items: center; gap: 12px; flex: 1; }
.item-icon { font-size: 32px; }
.item-info { }
.item-name { font-size: 15px; font-weight: 500; color: #2d3436; display: block; }
.item-time { font-size: 12px; color: #b2bec3; margin-top: 2px; display: block; }
.item-right { display: flex; align-items: center; gap: 8px; }
.item-pitch {
  font-size: 12px; color: #6c5ce7; background: #f0ecff; padding: 2px 8px; border-radius: 10px;
}
.item-arrow { font-size: 14px; color: #b2bec3; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 80px 20px;
}
.empty-icon { font-size: 64px; margin-bottom: 16px; }
.empty-title { font-size: 18px; color: #636e72; }
.empty-desc { font-size: 14px; color: #b2bec3; margin-top: 8px; }